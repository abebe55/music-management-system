# ════════════════════════════════════════════════════════════════════
#  MusicFlow Backend — Environment Variables
#  Copy this file to .env and fill in all values before running.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────
NODE_ENV=development
# PORT is injected automatically by Render in production.
# Set it here only for local development.
PORT=5000

# ── Database ──────────────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/music_management
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/music_management
MONGODB_URI=mongodb://localhost:27017/music_management

# ── JWT secrets ───────────────────────────────────────────────────────
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_different_strong_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────────────────────
# FRONTEND_URL — your Vercel deployment URL (production)
# e.g. https://musicflow.vercel.app
# Supports comma-separated list for multiple origins.
FRONTEND_URL=

# CORS_ORIGIN — local dev origin (also supports comma-separated)
CORS_ORIGIN=http://localhost:5173

# ── Email — Brevo transactional email ─────────────────────────────────
# 1. Register at https://app.brevo.com
# 2. Get API key: Settings → API Keys
# 3. Verify sender: Settings → Senders, Domains & IPs → Senders
# 4. Authorize your server IP: Settings → Security → Authorized IPs
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM_NAME=MusicFlow
# Must match a verified sender in your Brevo account
EMAIL_FROM_ADDRESS=your_verified_sender@example.com

# ── OTP settings ──────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Rate limiting ─────────────────────────────────────────────────────
# Window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
