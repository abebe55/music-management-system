# ════════════════════════════════════════════════════════════════════
#  MusicFlow Frontend — Environment Variables
#  Copy this file to .env and fill in all values before running.
#  For production builds, set these as Vercel environment variables.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════

# ── API base URL ──────────────────────────────────────────────────────
# Local dev:   http://localhost:5000/api/v1
# Production:  https://your-render-app.onrender.com/api/v1
#              (set this in Vercel dashboard under Environment Variables)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ── App name ─────────────────────────────────────────────────────────
VITE_APP_NAME=MusicFlow
